<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.wayline.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/app.wayline/wayline-daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Wayline/daemon.log</string>
	<key>StandardOutPath</key>
	<string>/Library/Logs/Wayline/daemon.log</string>
</dict>
</plist>
